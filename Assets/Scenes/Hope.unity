  messageText: {fileID: 1248897574}
  byLineText: {fileID: 268270433}
  pressEnterText: {fileID: 217365661}
  finalMessage: "You made it.\nThrough denial, guilt, loneliness, and rage \u2014
    you kept walking.\nThis journey was never about defeating monsters,\nbut meeting
    the parts of yourself you avoid the most.\nIf this game gave even a moment of
    clarity, comfort, or breath,\nthen it was worth creating.\n\nThank you for playing
    \u2014 truly!"
  byLine: "\u2014 Created by Devansh Srivastava"
  fadeTime: 1
