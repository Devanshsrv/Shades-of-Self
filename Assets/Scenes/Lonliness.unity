MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1557174729}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 062d7081991941242a6aee8cd33ecd04, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  levelTitle: LONELINESS
  levelDescription: "When guilt finally loosens its grip, loneliness steps in,\nquiet,
    cold, and echoing like an empty room inside your chest.\n\nYet even in this silence,
    a small light lingers\u2026\na wisp born from the last warm piece of you.\n\nFollow
    it.\nIt will rise where your heart must rise too.\nWhere its smoke drifts upward,
    you must leap twice \u2014\na reminder that even in your lowest moments,\nyou
    are still capable of lifting yourself higher than you think.\n\nLet the wisp
    guide you through the void.\nIt is the part of you that stayed when everything
    else left."
  titleText: {fileID: 883938693}
  descriptionText: {fileID: 1285586028}
  pressEnterText: {fileID: 1761768786}
